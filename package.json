{
  "name": "otetsudai-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/local.ts\" \"vite --host 0.0.0.0\"",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx tests/service.test.ts",
    "synth": "cdk synth --strict",
    "deploy": "npm run build && cdk deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "aws-cdk": "2.1144.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
